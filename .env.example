# GeoLook 引擎与发布凭证（复制为 .env；也可在看板「设置」里填写，会自动写入 .env）
# Engine & publishing credentials. Copy to .env, or fill them in the dashboard Settings page.
# 一个都不填也能跑：自动采样会跳过，无 API 引擎走人工采样表。

# ---- 国内引擎 CN engines ----
ZHIPUAI_API_KEY=
ARK_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
MINIMAX_API_KEY=

# ---- 海外引擎 Global engines ----
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=

# 可选：覆盖各引擎默认采样模型 Optional model overrides
# GLM_MODEL=  ARK_MODEL=  DEEPSEEK_MODEL=  MOONSHOT_MODEL=  MINIMAX_MODEL=
# GEMINI_MODEL=  OPENAI_MODEL=  ANTHROPIC_MODEL=  GROK_MODEL=  PERPLEXITY_MODEL=

# ---- 自定义 OpenAI 兼容 API（可选）Custom OpenAI-compatible API ----
# 需要同时填写 API Key、Base URL（不含 /chat/completions）和模型名。
# CUSTOM_API_NAME=我的自定义引擎
# CUSTOM_API_MARKET=cn
# CUSTOM_API_BASE_URL=https://api.example.com/v1
# CUSTOM_API_CHAT_PATH=chat/completions
# CUSTOM_API_MODEL=your-model-id
# CUSTOM_API_KEY=

# ---- 发布渠道（可选）Publishing channels, optional ----
GITHUB_TOKEN=
WP_USER=
WP_APP_PASSWORD=
WECHAT_APPID=
WECHAT_APPSECRET=
PUBLISH_WEBHOOK_URL=
WISGATE_CMS_TOKEN=
